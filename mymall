<html lang="zh‑CN">
<head>
<meta charset="UTF-8">
<title>网上商城</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<div class="header">
  <h1>🛒网上商城</h1>
  <div>购物车(<span>{{cart_count}}</span>)</div>
</div>

<div class="search-bar">
  <form action="/" method="get">
    <input type="text" name="search" placeholder="搜索商品" value="{{search}}">
    <select name="category">
      {% for c in categories %}
      <option value="{{c}}" {%if current_category==c%}selected{%endif%}>{{c}}</option>
      {%endfor%}
    </select>
    <select name="sort">
      <option value="default">默认</option>
      <option value="price_asc">价格升序</option>
      <option value="price_desc">价格降序</option>
      <option value="sales">销量</option>
      <option value="rating">评分</option>
    </select>
    <button type="submit">查询</button>
  </form>
</div>

<div class="product-list">
{% for p in products %}
<div class="product-card">
  < img src="{{p.image}}" alt="{{p.name}}">
  <h3>{{p.name}}</h3>
  <div class="price">¥{{p.price}}</div>
  <div>销量:{{p.sales}}｜评分:{{p.rating}}</div>
  <a href=" ">查看详情</a >
</div>
{%endfor%}
</div>
</body>
</html>
</html>
{%else%}
{%for item in cart_items%}
<div class="cart-item">
  <span>{{item.name}}</span>
  <span>¥{{item.price}} × {{item.quantity}}</span>
  <button onclick="del({{item.id}})">删除</button>
</div>
{%endfor%}
<div>合计：¥{{total_price}}，节省{{saved}}</div>
<a href="/checkout"><button>去结算</button></a >
{%endif%}

<script>
async function del(pid){
  const fd=new FormData();
  fd.append("product_id",pid);
  await fetch("/cart/remove",{method:"POST",body:fd});
  location.reload();
}
</script>
</body>
</html>
