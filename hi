# 商品分类
CATEGORIES = ['全部', '手机数码', '电脑办公', '数码配件', '运动户外', '家用电器', '美妆护肤']


# =============== 工具函数 ===============
def get_cart_count():
    """获取购物车商品数量"""
    cart = session.get('cart', [])
    return sum(item['quantity'] for item in cart)


def get_product_by_id(product_id):
    """根据ID获取商品"""
    for p in PRODUCTS:
        if p['id'] == product_id:
            return p
    return None


# =============== 路由 ===============
@app.route('/')
def index():
    """首页"""
    category = request.args.get('category', '全部')
    search = request.args.get('search', '').strip()
    sort = request.args.get('sort', 'default')

    # 筛选商品
    products = PRODUCTS.copy()

    if category != '全部':
        products = [p for p in products if p['category'] == category]

    if search:
        products = [p for p in products if search.lower() in p['name'].lower()
                    or search.lower() in p['description'].lower()]

    # 排序
    if sort == 'price_asc':
        products.sort(key=lambda x: x['price'])
    elif sort == 'price_desc':
        products.sort(key=lambda x: x['price'], reverse=True)
    elif sort == 'sales':
        products.sort(key=lambda x: x['sales'], reverse=True)
    elif sort == 'rating':
        products.sort(key=lambda x: x['rating'], reverse=True)

    # 轮播图数据
    banners = [
        {'title': '双11狂欢节', 'subtitle': '全场低至5折起', 'image': 'https://picsum.photos/seed/banner1/1200/400', 'color': '#ff6b6b'},
        {'title': '新品首发', 'subtitle': '数码新品抢先购', 'image': 'https://picsum.photos/seed/banner2/1200/400', 'color': '#4ecdc4'},
        {'title': '品牌特惠', 'subtitle': '大牌美妆限时优惠', 'image': 'https://picsum.photos/seed/banner3/1200/400', 'color': '#ffe66d'},
    ]

    context = {
        'products': products,
        'categories': CATEGORIES,
        'current_category': category,
        'search': search,
        'sort': sort,
        'banners': banners,
        'cart_count': get_cart_count(),
        'total_products': len(products),
    }
    return render_template('index.html', **context)


@app.route('/product/<int:product_id>')
def product_detail(product_id):
    """商品详情页"""
    product = get_product_by_id(product_id)
    if not product:
        return render_template('404.html'), 404

    # 推荐商品（同类其他商品）
    related = [p for p in PRODUCTS if p['category'] == product['category'] and p['id'] != product_id][:4]

    context = {
        'product': product,
        'related': related,
        'cart_count': get_cart_count(),
    }
    return render_template('product.html', **context)


@app.route('/cart')
def cart():
    """购物车页面"""
    cart_items = session.get('cart', [])
    total_price = sum(item['price'] * item['quantity'] for item in cart_items)
    total_original = sum(item['original_price'] * item['quantity'] for item in cart_items)
    saved = total_original - total_price

    context = {
        'cart_items': cart_items,
        'total_price': round(total_price, 2),
        'total_original': round(total_original, 2),
        'saved': round(saved, 2),
        'cart_count': get_cart_count(),
    }
    return render_template('cart.html', **context)


@app.route('/cart/add', methods=['POST'])
def add_to_cart():
    """添加到购物车"""
    product_id = request.form.get('product_id', type=int)
    quantity = request.form.get('quantity', 1, type=int)

    product = get_product_by_id(product_id)
    if not product:
        return jsonify({'success': False, 'message': '商品不存在'})

    cart = session.get('cart', [])

    # 检查是否已在购物车
    found = False
    for item in cart:
        if item['id'] == product_id:
            item['quantity'] += quantity
            found = True
            break

    if not found:
        cart.append({
            'id': product['id'],
            'name': product['name'],
            'price': product['price'],
            'original_price': product['original_price'],
            'image': product['image'],
            'quantity': quantity,
        })

    session['cart'] = cart
    count = sum(item['quantity'] for item in cart)

    return jsonify({
        'success': True,
        'message': '已加入购物车',
        'cart_count': count,
    })


@app.route('/cart/update', methods=['POST'])
def update_cart():
    """更新购物车数量"""
    product_id = request.form.get('product_id', type=int)
    quantity = request.form.get('quantity', 1, type=int)

    if quantity < 1:
        quantity = 1

    cart = session.get('cart', [])
    for item in cart:
        if item['id'] == product_id:
            item['quantity'] = quantity
            break

    session['cart'] = cart
    return jsonify({'success': True, 'cart_count': get_cart_count()})


@app.route('/cart/remove', methods=['POST'])
def remove_from_cart():
    """从购物车移除"""
    product_id = request.form.get('product_id', type=int)

    cart = session.get('cart', [])
    cart = [item for item in cart if item['id'] != product_id]
    session['cart'] = cart

    return jsonify({'success': True, 'cart_count': get_cart_count()})


@app.route('/checkout')
def checkout():
    """结算页（模拟）"""
    cart_items = session.get('cart', [])
    if not cart_items:
        return redirect(url_for('cart'))

    total_price = sum(item['price'] * item['quantity'] for item in cart_items)

    context = {
        'cart_items': cart_items,
        'total_price': round(total_price, 2),
        'cart_count': get_cart_count(),
    }
    return render_template('checkout.html', **context)


@app.route('/order/success')
def order_success():
    """下单成功（模拟）"""
    # 清空购物车
    session['cart'] = []
    return render_template('order_success.html', cart_count=0)


